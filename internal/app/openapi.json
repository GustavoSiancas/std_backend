{
  "openapi": "3.0.3",
  "info": {
    "title": "STD â€” Ãreas y usuarios",
    "version": "1.0.0",
    "description": "Estos endpoints no requieren token. Login devuelve user.admin para seleccionar la vista; no crea una sesiÃ³n. admin es de solo lectura y no se asigna mediante crear usuario."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/departments/organization-chart": {
      "get": {
        "summary": "Organigrama completo de areas",
        "description": "Sin token. Sin paginacion. Incluye areas activas e inactivas. roots contiene las areas sin padre y cada nodo contiene children. total es el numero de areas y root_count el numero de raices. Varias raices indican jerarquias independientes.",
        "security": [],
        "responses": {
          "200": {
            "description": "Organigrama",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "roots": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrganizationNode"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "root_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Ciclo o padre ausente"
          },
          "500": {
            "description": "Error interno"
          }
        }
      }
    },
    "/api/v1/departments": {
      "get": {
        "summary": "Listado paginado de departments",
        "security": [],
