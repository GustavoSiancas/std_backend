              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "department_id": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada invÃ¡lida",
