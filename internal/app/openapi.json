            "description": "Error interno"
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Crear usuario y asignarlo a un Ã¡rea",
        "tags": [
          "Usuarios"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OperaciÃ³n exitosa",
